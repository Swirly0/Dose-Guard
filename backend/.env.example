ROBOFLOW_API_KEY=your_private_api_key
ROBOFLOW_MODEL_ID=workspace/model-id
INFERENCE_SERVER_URL=http://localhost:9001

# Optional server settings (defaults shown)
# CAMERA_INDEX=1                 defaults to "camera" in regions.json
# CAMERA_WIDTH=1920
# CAMERA_HEIGHT=1080
# CAMERA_FRAMES=5                frames analysed per verification
# DETECTION_CONFIDENCE=0.4
# SCALE_PORT=COM5                auto-detects the Arduino when unset
# SCALE_STABLE_SAMPLES=5         readings that must agree before weight is trusted
# SCALE_MAX_SPREAD_G=0.05
# SCALE_SETTLE_TIMEOUT_S=8
# SERVER_PORT=8000
